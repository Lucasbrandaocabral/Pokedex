# Copie para .env.local e preencha (nunca envie o .env.local para o GitHub)
# Endereço do banco Postgres (na Vercel ele é criado sozinho ao conectar o Neon)
DATABASE_URL=postgres://usuario:senha@localhost:5432/pokedex
# Segredo usado para assinar as sessões e proteger o 2FA (mínimo 32 caracteres aleatórios)
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Só para rodar os testes locais (que criam muitas contas seguidas). Não use na Vercel.
# LIMITE_IP=desligado
